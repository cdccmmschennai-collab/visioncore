# Database
POSTGRES_USER=visioncore
POSTGRES_PASSWORD=visioncore
POSTGRES_DB=visioncore
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Security 
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

#  Claude API
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-5
# Raised from 4096: too tight a ceiling risks a dense multi-photo tag's
# response being cut off before the JSON is finished, which can surface as
# "Claude returned an empty response". Only tokens actually generated are
# billed, so a higher ceiling costs nothing when the model finishes early.
CLAUDE_MAX_TOKENS=8192

# Pricing recorded per extraction call, USD per 1,000,000 tokens.
# Update these to match your plan.
CLAUDE_INPUT_PRICE_PER_MTOK=3.00
CLAUDE_OUTPUT_PRICE_PER_MTOK=15.00

# Admin API key (separate from ANTHROPIC_API_KEY above) — required for the
# Admin page's Claude usage dashboard, which reads Anthropic's official
# Usage & Cost Admin API. Create one in the Console under Settings > Admin
# API keys (organization admins only). Leave unset and the dashboard
# reports itself unavailable rather than showing estimated figures.
ANTHROPIC_ADMIN_API_KEY=sk-ant-admin01-your-admin-key-here
# Display-only USD -> INR conversion rate for the Admin page, and the USD
# spend threshold (from Anthropic's official cost report) that triggers the
# spend warning banner.
USD_TO_INR_RATE=83.00
CLAUDE_SPEND_WARNING_USD=5.00

# Image optimization for Claude only (defaults in code shown) — a temporary,
# in-memory copy built just for the vision request when a photo exceeds a
# threshold below; the ORIGINAL FILE ON DISK IS NEVER MODIFIED. A photo
# under CLAUDE_IMAGE_MAX_DIMENSION_PX and CLAUDE_IMAGE_MAX_BYTES is sent
# completely unchanged. Raise CLAUDE_IMAGE_MAX_DIMENSION_PX/_MAX_BYTES if
# small nameplate text is coming back illegible; lower CLAUDE_IMAGE_JPEG_
# QUALITY only if you need smaller payloads and can tolerate softer text.
# CLAUDE_IMAGE_MAX_DIMENSION_PX=1600
# CLAUDE_IMAGE_MAX_BYTES=6291456
# CLAUDE_IMAGE_JPEG_QUALITY=88
# Hard ceiling on ONE photo's optimized output — an unusually detailed photo
# that's still over this after the standard pass gets one more, smaller/
# lower-quality pass. Comfortably under Anthropic's ~5 MB per-image limit
# even after base64 inflation (~33%).
# CLAUDE_IMAGE_HARD_MAX_BYTES=3145728
# Combined budget across ALL of one tag's optimized photos — a multi-photo
# tag (4-5 photos) can still add up to an oversized request even when each
# photo individually cleared the caps above; if the total exceeds this, the
# largest photo(s) get tightened further rather than the request going out
# oversized. Verify against Anthropic's current published request-size
# limits if you raise this a lot.
# CLAUDE_REQUEST_MAX_BYTES=12582912

#  Uploads
STORAGE_DIR=/data/storage
MAX_IMAGES_PER_BATCH=20
MAX_TAGS_PER_BATCH=10
MAX_IMAGES_PER_TAG=5
MAX_IMAGE_SIZE_MB=15
# The "Batch Process" folder-scan run's tag ceiling (default 200 in code —
# the frontend uploads a large run in chunks, see docs/DEPLOYMENT.md, so this
# no longer has to stay low to bound a single request's size). For an even
# larger run, raise it here.
# MAX_TAGS_PER_BATCH_PROCESS=400

#  Concurrent batch processing
# How many tags can be mid-extraction (a live Claude call) at once, across
# the whole backend process. Raise for higher throughput on large batches;
# keep comfortably below the DB pool size + max_overflow (30 by default).
EXTRACTION_MAX_CONCURRENCY=4
# Automatic retry for transient failures only (rate limit/timeout/connection/
# 5xx) — a permanent failure (bad request, corrupt image) never retries.
EXTRACTION_MAX_RETRIES=3
EXTRACTION_RETRY_BASE_DELAY_SECONDS=2.0
# Leave at 0 — the outer retry loop above owns retry policy; a nonzero value
# here would let the Anthropic SDK silently retry again inside one attempt.
CLAUDE_SDK_MAX_RETRIES=0
# Purely presentational grouping for the progress display ("Batch 2 of 4").
BATCH_PROGRESS_CHUNK_SIZE=25

#  App
COMPANY_NAME=Visioncore
CORS_ORIGINS=http://localhost:5174,http://localhost:4173

# The URL this server is actually reachable at from a user's PC — used to
# build the AI OUTPUT EXCEL / INPUT PHOTO hyperlinks embedded in an exported
# Template workbook (see backend/app/services/download_links.py). A local
# filesystem path only ever works on the machine that generated the file, so
# these links point here instead. Set to your real domain in production
# (e.g. https://your-domain.com); localhost:8000 is correct for local dev.
PUBLIC_BASE_URL=http://localhost:8000
# How long a signed download link stays valid. These workbooks are long-lived
# reference documents, so this defaults to a year rather than a short expiry.
DOWNLOAD_LINK_EXPIRE_DAYS=365

# Production -> local sync (pull-based; see backend/app/services/sync_client.py)
# SYNC_API_TOKEN must be the SAME shared secret in both environments' .env
# files: production uses it to authenticate incoming pulls, local uses it to
# authenticate outgoing ones. Generate with the same command as JWT_SECRET.
# SYNC_SOURCE_URL is the production API's base URL (e.g. https://your-domain.com)
# — set this ONLY on the local/mirror deployment. Leave it blank on
# production itself; that is what keeps the pull loop from starting there.
SYNC_API_TOKEN=
SYNC_SOURCE_URL=
SYNC_POLL_INTERVAL_SECONDS=30

