# Database
POSTGRES_USER=visioncore
POSTGRES_PASSWORD=visioncore
POSTGRES_DB=visioncore
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Security 
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

#  Claude API
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=4096

# Pricing used for the admin usage dashboard, USD per 1,000,000 tokens.
# Update these to match your plan.
CLAUDE_INPUT_PRICE_PER_MTOK=3.00
CLAUDE_OUTPUT_PRICE_PER_MTOK=15.00
# Credit budget the dashboard measures spend against.
CLAUDE_CREDIT_BUDGET_USD=100.00

#  Uploads 
STORAGE_DIR=/data/storage
MAX_IMAGES_PER_BATCH=20
MAX_TAGS_PER_BATCH=10
MAX_IMAGES_PER_TAG=5
MAX_IMAGE_SIZE_MB=15

#  Seed accounts (created on first boot only) 
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123
SEED_USER_USERNAME=user
SEED_USER_PASSWORD=User@123

#  App 
COMPANY_NAME=Visioncore
CORS_ORIGINS=http://localhost:5174,http://localhost:4173

