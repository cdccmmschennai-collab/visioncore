# Local (non-Docker) development. Docker Compose reads the root .env instead.
POSTGRES_USER=visioncore
POSTGRES_PASSWORD=visioncore
POSTGRES_DB=visioncore
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

JWT_SECRET=dev-only-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

AI_PROVIDER=gemini

GEMINI_API_KEY=change-in-production
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_TOKENS=4096
GEMINI_INPUT_PRICE_PER_MTOK=0
GEMINI_OUTPUT_PRICE_PER_MTOK=0

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=4096
CLAUDE_INPUT_PRICE_PER_MTOK=3.00
CLAUDE_OUTPUT_PRICE_PER_MTOK=15.00
CLAUDE_CREDIT_BUDGET_USD=100.00

STORAGE_DIR=./storage
MAX_IMAGES_PER_BATCH=20
MAX_TAGS_PER_BATCH=10
MAX_IMAGES_PER_TAG=5
MAX_IMAGE_SIZE_MB=15

#SEED_ADMIN_USERNAME=admin
#SEED_ADMIN_PASSWORD=Admin@123
#SEED_USER_USERNAME=user
#SEED_USER_PASSWORD=User@123

COMPANY_NAME=Visioncore
CORS_ORIGINS=http://localhost:5174,http://localhost:4173



