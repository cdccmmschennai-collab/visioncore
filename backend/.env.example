# Local (non-Docker) development. Docker Compose reads the root .env instead.
POSTGRES_USER=visioncore
POSTGRES_PASSWORD=visioncore
POSTGRES_DB=visioncore
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

JWT_SECRET=dev-only-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-5
# Raised from 4096: too tight a ceiling risks a dense multi-photo tag's
# response being cut off before the JSON is finished ("Claude returned an
# empty response"). Only tokens actually generated are billed.
CLAUDE_MAX_TOKENS=8192
CLAUDE_INPUT_PRICE_PER_MTOK=3.00
CLAUDE_OUTPUT_PRICE_PER_MTOK=15.00
# Admin API key (separate from ANTHROPIC_API_KEY above) — required for the
# Admin page's Claude usage dashboard. Create one in the Console under
# Settings > Admin API keys (organization admins only).
ANTHROPIC_ADMIN_API_KEY=sk-ant-admin01-your-admin-key-here
# Display-only USD -> INR conversion rate for the Admin page, and the USD
# spend threshold that triggers the spend warning banner.
USD_TO_INR_RATE=83.00
CLAUDE_SPEND_WARNING_USD=5.00

# Image optimization for Claude only (defaults in code shown) — a temporary,
# in-memory copy built just for the vision request when a photo exceeds a
# threshold below; the ORIGINAL FILE ON DISK IS NEVER MODIFIED.
# CLAUDE_IMAGE_MAX_DIMENSION_PX=1600
# CLAUDE_IMAGE_MAX_BYTES=6291456
# CLAUDE_IMAGE_JPEG_QUALITY=88
# Hard ceiling on ONE photo's optimized output (a second, smaller/lower-
# quality pass kicks in if the standard pass is still over this).
# CLAUDE_IMAGE_HARD_MAX_BYTES=3145728
# Combined budget across ALL of one tag's optimized photos — if a multi-
# photo tag's total is still over this, the largest photo(s) get tightened
# further rather than the request going out oversized.
# CLAUDE_REQUEST_MAX_BYTES=12582912

STORAGE_DIR=./storage
MAX_IMAGES_PER_BATCH=20
MAX_TAGS_PER_BATCH=10
MAX_IMAGES_PER_TAG=5
MAX_IMAGE_SIZE_MB=15
# The "Batch Process" folder-scan run's tag ceiling (default 200 in code —
# the frontend uploads a large run in chunks, so this no longer has to stay
# low to bound a single request's size). For an even larger run, raise it.
# MAX_TAGS_PER_BATCH_PROCESS=400

# Concurrent batch processing — how many tags can be mid-extraction (a live
# Claude call) at once, across the whole backend process. Keep comfortably
# below the DB pool size + max_overflow (30 by default).
EXTRACTION_MAX_CONCURRENCY=4
# Automatic retry for transient failures only (rate limit/timeout/connection/
# 5xx) — a permanent failure (bad request, corrupt image) never retries.
EXTRACTION_MAX_RETRIES=3
EXTRACTION_RETRY_BASE_DELAY_SECONDS=2.0
# Leave at 0 — the outer retry loop above owns retry policy; a nonzero value
# here would let the Anthropic SDK silently retry again inside one attempt.
CLAUDE_SDK_MAX_RETRIES=0
# Purely presentational grouping for the progress display ("Batch 2 of 4").
BATCH_PROGRESS_CHUNK_SIZE=25


COMPANY_NAME=Visioncore
CORS_ORIGINS=http://localhost:5174,http://localhost:4173,



